# Build environment for a portable FastECU Linux AppImage.
# Ubuntu 22.04 = glibc 2.35, so the AppImage runs on Ubuntu 22.04+, Debian 12+, Mint 21+, Fedora 36+.
# Qt is installed with aqtinstall into /opt/Qt/<ver>/gcc_64 (same path as the host Qt install).
FROM docker.io/library/ubuntu:22.04

ARG QT_VERSION=6.9.3
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates file wget python3 python3-pip \
        libssl-dev libgl1-mesa-dev libegl1 libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 \
        libxkbcommon0 libxkbcommon-x11-0 libx11-xcb1 libxcb1 libxcb-cursor0 libxcb-icccm4 \
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
        libxcb-xinerama0 libxcb-xkb1 libxcb-sync1 libxcb-xfixes0 libxcb-shm0 libxcb-util1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir aqtinstall \
    && aqt install-qt linux desktop ${QT_VERSION} linux_gcc_64 -O /opt/Qt \
        -m qtserialport qtwebsockets qtcharts qtremoteobjects qt5compat \
    && rm -rf /root/.cache aqtinstall.log

ENV PATH=/opt/Qt/${QT_VERSION}/gcc_64/bin:$PATH
# linuxdeploy is itself an AppImage and FUSE is not available in a container
ENV APPIMAGE_EXTRACT_AND_RUN=1
