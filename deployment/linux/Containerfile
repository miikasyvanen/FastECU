# Build environment for a portable FastECU Linux AppImage, for x86_64 and aarch64.
# The AppImage runs on distros with the same or newer glibc than the base image:
#   x86_64:  ubuntu:22.04 (glibc 2.35) -> Ubuntu 22.04+, Debian 12+, Mint 21+, Fedora 36+
#   aarch64: ubuntu:24.04 (glibc 2.39) -> Ubuntu 24.04+, Debian 13+, Raspberry Pi OS Trixie
#            (Qt's official arm64 binaries need glibc 2.38, so 22.04 cannot be used there)
# Qt is installed with aqtinstall into /opt/Qt/<ver>/gcc_64 or gcc_arm64; /opt/Qt/current points to it.
# Built with podman build --platform linux/amd64 or linux/arm64 (arm64 runs under qemu on an x86 host).
ARG BASE=ubuntu:22.04
FROM docker.io/library/${BASE}

ARG QT_VERSION=6.9.3
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive

# libglib2.0-0 is libglib2.0-0t64 on 24.04; pip needs --break-system-packages there (PEP 668)
RUN apt-get update && GLIB=$(apt-cache show libglib2.0-0t64 >/dev/null 2>&1 && echo libglib2.0-0t64 || echo libglib2.0-0) \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates file wget python3 python3-pip \
        libssl-dev libgl1-mesa-dev libegl1 libfontconfig1 libfreetype6 libdbus-1-3 $GLIB \
        libxkbcommon0 libxkbcommon-x11-0 libx11-xcb1 libxcb1 libxcb-cursor0 libxcb-icccm4 \
        libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
        libxcb-xinerama0 libxcb-xkb1 libxcb-sync1 libxcb-xfixes0 libxcb-shm0 libxcb-util1 \
        libsm6 libice6 \
    && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    case "$TARGETARCH" in \
        amd64) HOST=linux;       QTARCH=linux_gcc_64;    QTDIR=gcc_64 ;; \
        arm64) HOST=linux_arm64; QTARCH=linux_gcc_arm64; QTDIR=gcc_arm64 ;; \
        *) echo "unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac; \
    pip3 install --no-cache-dir aqtinstall 2>/dev/null || pip3 install --no-cache-dir --break-system-packages aqtinstall; \
    aqt install-qt $HOST desktop ${QT_VERSION} $QTARCH -O /opt/Qt \
        -m qtserialport qtwebsockets qtcharts qtremoteobjects qt5compat; \
    ln -s /opt/Qt/${QT_VERSION}/$QTDIR /opt/Qt/current; \
    rm -rf /root/.cache aqtinstall.log

ENV PATH=/opt/Qt/current/bin:$PATH
# linuxdeploy is itself an AppImage and FUSE is not available in a container
ENV APPIMAGE_EXTRACT_AND_RUN=1
